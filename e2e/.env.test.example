# Copy this to .env.test and fill in values
# cp .env.test.example .env.test

# LocalWP Site
SITE_URL=https://smoketree-ai.local

# WordPress Admin
WP_ADMIN_USER=admin
WP_ADMIN_PASS=admin

# Database (LocalWP)
DB_HOST=localhost
DB_PORT=10010
DB_NAME=local
DB_USER=root
DB_PASS=root

# WP-CLI path (optional)
WP_CLI_PATH=wp

# Stripe Test Keys
STRIPE_TEST_PK=pk_test_...
STRIPE_TEST_SK=sk_test_...

# Test Member Credentials (created by seed script)
TEST_MEMBER_EMAIL=testmember@example.com
TEST_MEMBER_PASS=TestPass123!
TEST_HOUSEHOLD_EMAIL=testhousehold@example.com
TEST_HOUSEHOLD_PASS=TestPass123!
TEST_DUO_EMAIL=testduo@example.com
TEST_DUO_PASS=TestPass123!
TEST_CIVIC_EMAIL=testcivic@example.com
TEST_CIVIC_PASS=TestPass123!
